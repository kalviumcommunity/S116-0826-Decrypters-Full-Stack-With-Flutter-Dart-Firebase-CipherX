// ============================================================================
// CIPHER-X PRODUCTION FIRESTORE SECURITY RULES (v1.0.0 RELEASE)
// Team Decrypters — Zero Client Trust Architecture
// Strict Multi-Tenant Scoping, Role-Based Access, Immutable Audit Trails
// ============================================================================
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================================
    // HELPER FUNCTIONS: Authentication, Roles & Tenant Isolation
    // ==========================================================
    
    // Check if the user is authenticated via Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the authenticated user matches the specified userId
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Fetch the authenticated user's profile document
    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Check if authenticated user belongs to the target organization
    function isMemberOf(orgId) {
      return isAuthenticated() 
        && getUserDoc().data.organizationId == orgId;
    }

    // Check if user is an admin or supervisor of the target organization
    function isAdminOrSupervisor(orgId) {
      return isMemberOf(orgId) 
        && (getUserDoc().data.role in ['admin', 'supervisor']);
    }

    // Check if user is a guard of the target organization
    function isGuard(orgId) {
      return isMemberOf(orgId) 
        && getUserDoc().data.role == 'guard';
    }

    // ==========================================================
    // TOP-LEVEL COLLECTIONS
    // ==========================================================

    // User Profiles (/users/{userId})
    match /users/{userId} {
      // Read: Self ownership, OR admin/supervisor of the same organization
      allow read: if isOwner(userId) 
        || (isAuthenticated() 
            && resource.data.organizationId == getUserDoc().data.organizationId 
            && getUserDoc().data.role in ['admin', 'supervisor']);

      // Create: User can create their own profile during registration/onboarding
      allow create: if isOwner(userId) 
        && request.resource.data.uid == userId
        && request.resource.data.organizationId != null
        && request.resource.data.organizationId != '';

      // Update: User can update their own profile, but security fields are immutable
      allow update: if isOwner(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.status == resource.data.status
        && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
        && (!('role' in resource.data) || request.resource.data.role == resource.data.role);

      // Delete: Strictly forbidden (user accounts preserved for audit integrity)
      allow delete: if false;

      // Device Tokens Subcollection (/users/{userId}/devices/{deviceId})
      match /devices/{deviceId} {
        // Read & Write: Authenticated device owner only
        allow read, write: if isOwner(userId);
      }
    }


    // ==========================================================
    // TENANT ISOLATION BOUNDARY (/organizations/{organizationId})
    // ==========================================================

    match /organizations/{organizationId} {
      // Organization Document: Read-only for verified tenant members
      allow read: if isMemberOf(organizationId);
      
      // Client writes directly to organization root are forbidden
      allow write: if false;

      // --------------------------------------------------------
      // Guard Directory Subcollection (PR #30 Command Center)
      // --------------------------------------------------------
      match /guards/{guardId} {
        // Read: Admin/supervisor of org, OR the individual guard reading own record
        allow read: if isAuthenticated() 
          && (isAdminOrSupervisor(organizationId) || (isMemberOf(organizationId) && guardId == request.auth.uid));

        // Create: Admin or supervisor of the organization only
        allow create: if isAdminOrSupervisor(organizationId)
          && request.resource.data.organizationId == organizationId
          && request.resource.data.guardId == guardId
          && request.resource.data.name is string
          && request.resource.data.name != ''
          && request.resource.data.createdAt == request.time;

        // Update: Admin or supervisor of the organization only
        allow update: if isAdminOrSupervisor(organizationId)
          && request.resource.data.organizationId == resource.data.organizationId
          && request.resource.data.guardId == resource.data.guardId
          && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt);

        // Delete: Strictly forbidden (soft delete via status is used)
        allow delete: if false;
      }

      // --------------------------------------------------------
      // Site Subcollection (PR #31 Site Coverage)
      // --------------------------------------------------------
      match /sites/{siteId} {
        // Read: Authenticated members of the organization (needed for geofencing/check-in)
        allow read: if isMemberOf(organizationId);

        // Create: Admin or supervisor of the organization only
        allow create: if isAdminOrSupervisor(organizationId)
          && request.resource.data.organizationId == organizationId
          && request.resource.data.siteId == siteId
          && request.resource.data.name is string
          && request.resource.data.name != '';

        // Update: Admin or supervisor of the organization only
        allow update: if isAdminOrSupervisor(organizationId)
          && request.resource.data.organizationId == resource.data.organizationId
          && request.resource.data.siteId == resource.data.siteId
          && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt);

        // Delete: Strictly forbidden
        allow delete: if false;
      }

      // --------------------------------------------------------
      // Shift Subcollection
      // --------------------------------------------------------
      match /shifts/{shiftId} {
        // Read: Admin/supervisor of org, OR assigned guard
        allow read: if isAuthenticated() 
          && (isAdminOrSupervisor(organizationId) || (isMemberOf(organizationId) && resource.data.guardId == request.auth.uid));

        // Create: Admin or supervisor of the organization only
        allow create: if isAdminOrSupervisor(organizationId)
          && request.resource.data.organizationId == organizationId
          && request.resource.data.shiftId == shiftId
          && request.resource.data.guardId is string
          && request.resource.data.guardId != ''
          && request.resource.data.siteId is string
          && request.resource.data.siteId != '';

        // Update: Admin or supervisor of the organization only
        allow update: if isAdminOrSupervisor(organizationId)
          && request.resource.data.organizationId == resource.data.organizationId
          && request.resource.data.shiftId == resource.data.shiftId
          && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt);

        // Delete: Strictly forbidden
        allow delete: if false;
      }

      // --------------------------------------------------------
      // Attendance Records Subcollection (PR #21, PR #24)
      // --------------------------------------------------------
      match /attendance/{attendanceId} {
        // Read: Admin or supervisor of the organization, OR the owning guard
        allow read: if isAuthenticated() 
          && (isAdminOrSupervisor(organizationId) || (isMemberOf(organizationId) && resource.data.guardId == request.auth.uid));

        // Create: Authenticated guard checking in for themselves within their own organization
        allow create: if isAuthenticated()
          && isMemberOf(organizationId)
          && getUserDoc().data.role == 'guard'
          && request.resource.data.organizationId == organizationId
          && request.resource.data.guardId == request.auth.uid
          && request.resource.data.shiftId is string
          && request.resource.data.shiftId != ''
          && request.resource.data.siteId is string
          && request.resource.data.siteId != ''
          && request.resource.data.status == 'active'
          && request.resource.data.checkInTime == request.time;

        // Update: Guard updating check-out for themselves, strictly preserving immutable check-in audit fields
        allow update: if isAuthenticated()
          && isMemberOf(organizationId)
          && request.auth.uid == resource.data.guardId
          && request.resource.data.organizationId == resource.data.organizationId
          && request.resource.data.guardId == resource.data.guardId
          && request.resource.data.shiftId == resource.data.shiftId
          && request.resource.data.siteId == resource.data.siteId
          && request.resource.data.checkInTime == resource.data.checkInTime
          && request.resource.data.verificationMethod == resource.data.verificationMethod
          && request.resource.data.checkInLatitude == resource.data.checkInLatitude
          && request.resource.data.checkInLongitude == resource.data.checkInLongitude
          && request.resource.data.checkInAccuracy == resource.data.checkInAccuracy;

        // Delete: Strictly forbidden (audit attendance records are immutable and permanent)
        allow delete: if false;
      }

      // --------------------------------------------------------
      // Incident Reporting Subcollection (PR #26, PR #27, PR #28)
      // --------------------------------------------------------
      match /incidents/{incidentId} {
        // Read: Authenticated members of the organization
        allow read: if isMemberOf(organizationId);

        // Create: Authenticated member reporting an incident for themselves within their own organization
        allow create: if isMemberOf(organizationId)
          && request.resource.data.organizationId == organizationId
          && request.resource.data.reportedBy == request.auth.uid
          && request.resource.data.siteId is string
          && request.resource.data.siteId != ''
          && request.resource.data.type is string
          && request.resource.data.type != ''
          && request.resource.data.description is string
          && request.resource.data.description != ''
          && request.resource.data.severity in ['LOW', 'MEDIUM', 'HIGH', 'CRITICAL']
          && request.resource.data.status == 'OPEN'
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && (!('resolvedAt' in request.resource.data) || request.resource.data.resolvedAt == null)
          && (!('resolvedBy' in request.resource.data) || request.resource.data.resolvedBy == null);

        // Update: Incident Management (PR #28) - Admin & Supervisor lifecycle operations
        allow update: if isAdminOrSupervisor(organizationId)
          && request.resource.data.organizationId == resource.data.organizationId
          && request.resource.data.reportedBy == resource.data.reportedBy
          && request.resource.data.siteId == resource.data.siteId
          && request.resource.data.type == resource.data.type
          && request.resource.data.description == resource.data.description
          && request.resource.data.severity == resource.data.severity
          && request.resource.data.createdAt == resource.data.createdAt
          && (!('latitude' in resource.data) || request.resource.data.latitude == resource.data.latitude)
          && (!('longitude' in resource.data) || request.resource.data.longitude == resource.data.longitude)
          && request.resource.data.updatedAt == request.time
          && (
            // Transition from OPEN -> INVESTIGATING
            (resource.data.status == 'OPEN' && request.resource.data.status == 'INVESTIGATING'
              && (!('resolvedAt' in request.resource.data) || request.resource.data.resolvedAt == null)
              && (!('resolvedBy' in request.resource.data) || request.resource.data.resolvedBy == null)
              && (!('resolution' in request.resource.data) || request.resource.data.resolution == null))
            // Transition from OPEN or INVESTIGATING -> RESOLVED
            || ((resource.data.status == 'OPEN' || resource.data.status == 'INVESTIGATING')
              && request.resource.data.status == 'RESOLVED'
              && request.resource.data.resolvedBy == request.auth.uid
              && request.resource.data.resolvedAt == request.time
              && request.resource.data.resolution is string
              && request.resource.data.resolution != '')
          );

        // Delete: Strictly forbidden (incident audit trail is immutable)
        allow delete: if false;

        // Incident Evidence Subcollection (PR #27)
        match /evidence/{evidenceId} {
          // Read: Authenticated members of the organization
          allow read: if isMemberOf(organizationId);

          // Create: Authenticated reporter in the same organization
          allow create: if isMemberOf(organizationId)
            && request.resource.data.organizationId == organizationId
            && request.resource.data.incidentId == incidentId
            && request.resource.data.uploadedBy == request.auth.uid
            && request.resource.data.createdAt == request.time
            && request.resource.data.sizeBytes is int
            && request.resource.data.sizeBytes <= 10485760
            && request.resource.data.contentType in ['image/jpeg', 'image/png', 'image/webp', 'application/pdf'];

          // Updates and deletions forbidden
          allow update, delete: if false;
        }
      }

      // --------------------------------------------------------
      // Alerts Subcollection (PR #29 Alert Engine)
      // --------------------------------------------------------
      match /alerts/{alertId} {
        // Read: Authenticated members of the organization
        allow read: if isMemberOf(organizationId);

        // Create: Authenticated member within their organization creating an alert
        allow create: if isMemberOf(organizationId)
          && request.resource.data.organizationId == organizationId
          && request.resource.data.alertId == alertId
          && request.resource.data.type in ['MISSED_SHIFT', 'LATE_CHECK_IN', 'UNDERSTAFFED_SITE', 'CRITICAL_INCIDENT']
          && request.resource.data.sourceEntityId is string
          && request.resource.data.sourceEntityId != ''
          && request.resource.data.sourceEntityType in ['shift', 'site', 'incident']
          && request.resource.data.status in ['active', 'acknowledged', 'resolved']
          && request.resource.data.createdAt == request.time;

        // Update: Authorized admin or supervisor can update status
        allow update: if isAdminOrSupervisor(organizationId)
          && request.resource.data.organizationId == resource.data.organizationId
          && request.resource.data.alertId == resource.data.alertId
          && request.resource.data.type == resource.data.type
          && request.resource.data.sourceEntityId == resource.data.sourceEntityId
          && request.resource.data.sourceEntityType == resource.data.sourceEntityType
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.status in ['active', 'acknowledged', 'resolved'];

        // Delete: Strictly forbidden (alerts are immutable audit trail)
        allow delete: if false;
      }

      // --------------------------------------------------------
      // Audit Logs Subcollection (PR #32 Activity Feed)
      // --------------------------------------------------------
      match /auditLogs/{logId} {
        // Read: Authenticated members of the organization with admin or supervisor role
        allow read: if isAdminOrSupervisor(organizationId);

        // Write: Strictly forbidden from client (audit logs are created server-side or via backend)
        allow create, update, delete: if false;
      }
    }

    // ==========================================================
    // DEFAULT DENY FALLBACK
    // ==========================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
