rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check authentication
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check self ownership
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User Profile security boundaries
    match /users/{userId} {
      allow read: if isOwner(userId);
      
      allow create: if isOwner(userId) 
        && request.resource.data.uid == userId
        && request.resource.data.organizationId != null
        && request.resource.data.organizationId != '';

      allow update: if isOwner(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.status == resource.data.status
        && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
        && (!('role' in resource.data) || request.resource.data.role == resource.data.role);

      allow delete: if false;
    }

    // Organization document rules (Read-only for members; client writes forbidden)
    match /organizations/{organizationId} {
      allow read: if isAuthenticated() 
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organizationId == organizationId;
      
      allow write: if false;

      // Attendance records subcollection security boundaries
      match /attendance/{attendanceId} {
        // Read: authenticated members of the organization
        allow read: if isAuthenticated() 
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organizationId == organizationId;

        // Create: Authenticated guard checking in for themselves within their own organization
        allow create: if isAuthenticated()
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organizationId == organizationId
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'guard'
          && request.resource.data.organizationId == organizationId
          && request.resource.data.guardId == request.auth.uid
          && request.resource.data.shiftId is string
          && request.resource.data.shiftId != ''
          && request.resource.data.siteId is string
          && request.resource.data.siteId != ''
          && request.resource.data.status == 'active'
          && request.resource.data.checkInTime == request.time;

        // Update: Guard updating check-out for themselves, strictly preserving immutable check-in audit fields
        allow update: if isAuthenticated()
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organizationId == organizationId
          && request.auth.uid == resource.data.guardId
          && request.resource.data.organizationId == resource.data.organizationId
          && request.resource.data.guardId == resource.data.guardId
          && request.resource.data.shiftId == resource.data.shiftId
          && request.resource.data.siteId == resource.data.siteId
          && request.resource.data.checkInTime == resource.data.checkInTime
          && request.resource.data.verificationMethod == resource.data.verificationMethod
          && request.resource.data.checkInLatitude == resource.data.checkInLatitude
          && request.resource.data.checkInLongitude == resource.data.checkInLongitude
          && request.resource.data.checkInAccuracy == resource.data.checkInAccuracy;

        // Delete: strictly forbidden (audit attendance records are immutable and permanent)
        allow delete: if false;
      }

      // Incident reporting subcollection security boundaries (PR #26)
      match /incidents/{incidentId} {
        // Read: authenticated members of the organization
        allow read: if isAuthenticated() 
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organizationId == organizationId;

        // Create: Authenticated member reporting an incident for themselves within their own organization
        allow create: if isAuthenticated()
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organizationId == organizationId
          && request.resource.data.organizationId == organizationId
          && request.resource.data.reportedBy == request.auth.uid
          && request.resource.data.siteId is string
          && request.resource.data.siteId != ''
          && request.resource.data.type is string
          && request.resource.data.type != ''
          && request.resource.data.description is string
          && request.resource.data.description != ''
          && request.resource.data.severity in ['LOW', 'MEDIUM', 'HIGH', 'CRITICAL']
          && request.resource.data.status == 'OPEN'
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && (!('resolvedAt' in request.resource.data) || request.resource.data.resolvedAt == null)
          && (!('resolvedBy' in request.resource.data) || request.resource.data.resolvedBy == null);

        // Update: Reserved for Incident Management (PR #28)
        allow update: if false;

        // Delete: Strictly forbidden (incident audit trail is immutable)
        allow delete: if false;
      }
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
